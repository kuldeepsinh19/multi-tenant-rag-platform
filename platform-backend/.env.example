# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# ENV drives the security posture. Any value other than development/dev/local/test/testing/ci
# is treated as PRODUCTION, which: disables /docs, /redoc & /openapi.json; sends HSTS; and
# fails startup unless JWT_SECRET is strong (not a placeholder, >=32 chars) and every selected
# provider has its API key set. Keep it `development` for local work.
ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://platform:platform@postgres:5432/platform
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

DASHBOARD_ORIGINS=["http://localhost:5173"]

# --- LLM / embedding provider selection ---
# Swap providers by changing these lines only — no code changes required.
# Defaults below are the verified working free-tier Gemini setup (just a GEMINI_API_KEY).
# To use Groq instead (faster): set LLM_PROVIDER=groq, LLM_MODEL=llama-3.3-70b-versatile,
# and GROQ_API_KEY=... — a pure env change, nothing else.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=gemini
# Free-tier gotcha: some keys have zero generateContent quota for gemini-2.0-flash /
# gemini-2.0-flash-lite (429 RESOURCE_EXHAUSTED, limit: 0). gemini-flash-latest works.
# It's a 2.5-class "thinking" model, so a grounded RAG turn takes ~15-20s (expected).
LLM_MODEL=gemini-flash-latest
LLM_FALLBACK_MODEL=gemini-flash-latest
GROQ_API_KEY=
GEMINI_API_KEY=

EMBED_PROVIDER=gemini
# Free-tier gotcha: text-embedding-004 returns 404 on the current Gemini API.
# gemini-embedding-001 works; it defaults to 3072 dims but is truncated to 768 (via
# output_dimensionality) to match the pgvector column — keep EMBED_DIM=768.
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

RATE_LIMIT_REQUESTS_PER_MINUTE=30
PER_BUSINESS_DAILY_TOKEN_BUDGET=200000

# --- Observability / tracing (Langfuse) ---
# Leave empty to disable tracing entirely (strict no-op, no errors). Set all three to
# enable end-to-end request tracing. Never commit real keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

RETRIEVAL_TOP_K_CANDIDATES=20
RETRIEVAL_TOP_K_FINAL=5
RETRIEVAL_MIN_SCORE=0.35

AGENT_MAX_RETRIES=2
